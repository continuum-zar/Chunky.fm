# Copy to .env; docker compose (and ./start.sh) read it from this directory.
# This is the compose-level environment; server/.env is the one `npm run dev`
# reads when running outside Docker.

# Optional. Leave it empty and the decks fall back to a code baked into the
# server; see `houseKey` in server/src/config.ts, which explains how to read it
# back. This is the one thing an unconfigured station does guard: listening is
# open, driving is not.
#
# Set this to give the decks a password you chose, which anything reachable from
# the internet should do. It also signs the admin session cookie, so changing it
# signs everyone out.
ADMIN_PASSWORD=

# Optional, and empty is the ordinary case: with no key set, anybody with the
# address can listen and nobody is asked for anything on the way in.
#
# Set this to put a door on. Everything below is what happens when you do, and
# none of it was removed to make the station open, only switched off:
#
#     https://<your-station>/?k=$STATION_KEY
#
# It is the same secret typed at the door or carried by a link. The browser
# presents it once and keeps a signed cookie for a month, so the link is needed
# once per device, and somebody who was told the code instead can type it on the
# refused screen. Rotating this locks every device out at the same moment, which
# is how you un-invite somebody.
#
# Generate one with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
#
# If you forget which code is in force: sign in to the console and press Share.
# Admin credentials satisfy the listener gate too, so whoever holds
# ADMIN_PASSWORD can always get in and read it back.
STATION_KEY=

# Obsolete, and harmless. Taking the door off used to need this; an open station
# is now the default, so it says nothing. Kept accepted rather than an error so
# a file that has been carrying it keeps meaning what it always meant. An
# explicit STATION_KEY still wins.
STATION_OPEN=

# How two browsers find each other, for the mic.
#
# The voice is peer-to-peer: it never touches the server, which is why a mic
# costs nothing to run. What two browsers behind two routers need is help
# discovering each other, and that is all these are. Nothing about the station,
# the music or who is listening crosses them — only a browser's own address.
#
# STUN_URLS is the only thing this station reaches that it was not told to.
# Everything else here is self-hosted on purpose, so the default is called out
# rather than left to be found in a network tab. Point it somewhere else, or set
# it to an empty string to ask nobody, which works on a LAN and nowhere else.
#
# STUN_URLS=stun:stun.l.google.com:19302

# The relay, for the roughly one listener in six behind a NAT strict enough that
# no direct path exists. Without it those listeners hear the music duck and then
# silence, which is invisible from the console.
#
# Mono voice is ~32 kbps, so a relayed listener costs about 14 MB an hour: a few
# hundred megabytes across a long evening, which is inside every free tier going
# (Cloudflare Realtime, Metered) and inside the smallest VPS running coturn.
#
# All three together or none at all; half a relay is refused at boot, because
# the alternative is finding out when somebody cannot hear you. If you run your
# own coturn, prefer its REST scheme (a username of `<expiry>:<name>` and an
# HMAC as the credential) so a leaked answer is worthless within the hour.
#
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# How much the station says about itself. `info` by default.
#
# Set to `debug` when a voice will not connect: every ICE candidate the station
# relays becomes a line, which says whether two browsers are exchanging
# addresses at all and in which direction they stop. Far too much to leave on,
# and exactly what is wanted for the ten minutes somebody is looking. The other
# half of that picture is in the browser console on both machines, under
# `[voice]`.
# LOG_LEVEL=info

# Host ports. The station is at http://localhost:$WEB_PORT.
#
# Deliberately not 5173/3000: those are what `npm run dev` uses, and half of
# everything else besides. High enough to be unclaimed, below 32768 so they
# cannot collide with an outbound socket that borrowed an ephemeral port.
WEB_PORT=18173
SERVER_PORT=13000

# Largest accepted upload, in bytes. Default 150 MiB.
MAX_UPLOAD_BYTES=157286400

# Passed through to the server. Default true: nginx is in front of it here, so
# the sign-in throttle has to read the caller through X-Forwarded-For rather
# than pacing everyone as one. See server/.env.example.
# TRUST_PROXY=true
